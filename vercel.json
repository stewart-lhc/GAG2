{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/trading-calculator/?$",
      "headers": { "Location": "/grow-a-garden-2-trading-calculator/" },
      "status": 308
    },
    {
      "src": "^/value-list/?$",
      "headers": { "Location": "/grow-a-garden-2-value-list/" },
      "status": 308
    },
    {
      "src": "^/mutation-calculator/?$",
      "headers": { "Location": "/grow-a-garden-2-mutation-calculator/" },
      "status": 308
    },
    {
      "src": "^/seed-restock-time/?$",
      "headers": { "Location": "/grow-a-garden-2-seed-restock-time/" },
      "status": 308
    },
    {
      "src": "^/grow-a-garden-2-calculator/?$",
      "headers": { "Location": "/" },
      "status": 308
    },
    {
      "src": "^/grow-a-garden-2-calculator(?:/.*)?/?$",
      "headers": { "Location": "/" },
      "status": 308
    }
  ]
}
